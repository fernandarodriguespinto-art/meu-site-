/* ==========================================
VARIÁVEIS
========================================== */

:root {

--primary: #2563eb;
--primary-light: #38bdf8;

--background: #07111f;
--background-2: #0b1728;

--card: #0d1b2d;

--text: #ffffff;
--text-light: #94a3b8;

--border: #1e3a5f;

--shadow:
    0 20px 60px rgba(0, 0, 0, 0.25);


}

/* ==========================================
TEMA CLARO
========================================== */

body.light {

--background: #f8fafc;
--background-2: #eef4fb;

--card: #ffffff;

--text: #0f172a;
--text-light: #64748b;

--border: #dbe4ef;


}

/* ==========================================
RESET
========================================== */

{
margin: 0;
padding: 0;
box-sizing: border-box;
}

html {
scroll-behavior: smooth;
}

body {

font-family:
    Arial,
    Helvetica,
    sans-serif;

background: var(--background);

color: var(--text);

line-height: 1.6;

transition:
    background 0.3s,
    color 0.3s;


}

a {
text-decoration: none;
color: inherit;
}

img {
max-width: 100%;
display: block;
}

button,
input {
font: inherit;
}

/* ==========================================
CONTAINER
========================================== */

.container {

width: 100%;

max-width: 1150px;

margin: 0 auto;

padding:
    0 25px;


}

/* ==========================================
HEADER
========================================== */

.header {

position: sticky;

top: 0;

z-index: 999;

background:
    rgba(7, 17, 31, 0.88);

backdrop-filter:
    blur(15px);

border-bottom:
    1px solid var(--border);


}

body.light .header {

background:
    rgba(255, 255, 255, 0.9);


}

.header-content {

min-height: 75px;

display: flex;

align-items: center;

justify-content: space-between;

gap: 25px;


}

/* LOGO */

.logo {

display: flex;

align-items: center;

gap: 12px;

font-size: 20px;

font-weight: bold;


}

.logo img {

width: 45px;

height: 45px;

object-fit: cover;

border-radius: 10px;


}

.logo span {

background:
    linear-gradient(
        90deg,
        var(--text),
        var(--primary-light)
    );

-webkit-background-clip: text;

color: transparent;


}

/* MENU */

.menu {

display: flex;

gap: 30px;


}

.menu a {

color: var(--text-light);

font-size: 15px;

transition: 0.3s;


}

.menu a:hover {

color: var(--primary-light);


}

/* BOTÕES DO HEADER */

.header-buttons {

display: flex;

align-items: center;

gap: 10px;


}

.icon-button,
.menu-button {

width: 42px;

height: 42px;

border:
    1px solid var(--border);

border-radius: 10px;

background:
    var(--card);

color: var(--text);

cursor: pointer;

transition: 0.3s;


}

.icon-button:hover,
.menu-button:hover {

border-color:
    var(--primary-light);

transform:
    translateY(-2px);


}

.menu-button {

display: none;


}

/* ==========================================
HERO
========================================== */

.hero {

min-height: 720px;

display: flex;

align-items: center;

background:

    radial-gradient(
        circle at 80% 30%,
        rgba(37, 99, 235, 0.28),
        transparent 35%
    ),

    radial-gradient(
        circle at 10% 80%,
        rgba(56, 189, 248, 0.08),
        transparent 30%
    );


}

.hero-content {

display: grid;

grid-template-columns:
    1.15fr 0.85fr;

align-items: center;

gap: 70px;


}

.tag {

display: inline-block;

color:
    var(--primary-light);

font-size: 12px;

font-weight: bold;

letter-spacing: 2px;

margin-bottom: 18px;


}

.hero h1 {

font-size:
    clamp(48px, 7vw, 80px);

line-height:
    1.02;

letter-spacing:
    -3px;

margin-bottom: 25px;


}

.hero h1 span {

color:
    var(--primary-light);


}

.hero p {

max-width: 620px;

color:
    var(--text-light);

font-size: 18px;

margin-bottom: 35px;


}

/* BOTÕES */

.hero-buttons {

display: flex;

gap: 15px;

flex-wrap: wrap;


}

.button {

display: inline-block;

padding:
    14px 24px;

border-radius: 10px;

font-weight: bold;

border: none;

cursor: pointer;

transition: 0.3s;


}

.button.primary {

background:
    var(--primary);

color: white;

box-shadow:
    0 10px 30px
    rgba(37, 99, 235, 0.3);


}

.button.primary:hover {

transform:
    translateY(-3px);

background:
    #1d4ed8;


}

.button.secondary {

border:
    1px solid var(--border);

color:
    var(--text);


}

.button.secondary:hover {

border-color:
    var(--primary-light);

color:
    var(--primary-light);


}

/* ESTATÍSTICAS */

.stats {

display: flex;

gap: 45px;

margin-top: 50px;


}

.stats div {

display: flex;

flex-direction: column;


}

.stats strong {

font-size: 25px;

color:
    var(--text);


}

.stats span {

color:
    var(--text-light);

font-size: 13px;


}

/* ==========================================
HERO VISUAL
========================================== */

.hero-visual {

position: relative;

min-height: 420px;

display: flex;

align-items: center;

justify-content: center;


}

.hero-visual > img {

position: relative;

z-index: 2;

width: 280px;

height: 280px;

object-fit: cover;

border-radius: 40px;

border:
    1px solid var(--border);

box-shadow:
    0 0 100px
    rgba(37, 99, 235, 0.35);

animation:
    float 4s ease-in-out infinite;


}

.glow {

position: absolute;

width: 300px;

height: 300px;

background:
    var(--primary);

filter:
    blur(120px);

opacity:
    0.25;


}

@keyframes float {

0%,
100% {
    transform:
        translateY(0);
}

50% {
    transform:
        translateY(-18px);
}


}

/* CARDS FLUTUANTES */

.floating-card {

position: absolute;

z-index: 5;

padding:
    12px 18px;

border:
    1px solid var(--border);

border-radius: 10px;

background:
    rgba(13, 27, 45, 0.9);

backdrop-filter:
    blur(10px);

box-shadow:
    var(--shadow);

font-size: 13px;

font-weight: bold;


}

.card-one {

top: 50px;

left: 20px;


}

.card-two {

top: 180px;

right: 0;


}

.card-three {

bottom: 60px;

left: 30px;


}

